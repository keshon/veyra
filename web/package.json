    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "vite": "^6.0.0",
    "typescript": "^5.7.0",
    "svelte-check": "^4.0.0",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.0.0"
  }
}
